<div class="d-flex justify-content-center align-items-center" style="min-height: 90vh; background-color:#f8f9fa;">

    <div class="text-center p-4 rounded-4 shadow" style="background:white; max-width:400px; width:100%;">

        <form action="" class="mx-auto">

            <h3 class="mb-4">Registro</h3>

            <div class="mb-3 text-start">
                <label for="nombre" class="form-label fw-semibold">Nombre</label>
                <input type="text" class="form-control form-control-lg" id="nombre" name="nombre"/>
            </div>

            <div class="mb-3 text-start">
                <label for="apellido" class="form-label fw-semibold">Apellido</label>
                <input type="text" class="form-control form-control-lg" id="apellido" name="apellido"/>
            </div>

            <div class="mb-3 text-start">
                <label for="fechaNa" class="form-label fw-semibold">Fecha de Nacimiento</label>
                <input type="date" class="form-control form-control-lg" id="fechaNa" name="fechaNa"/>
            </div>

            <div class="mb-3 text-start">
                <label for="correo" class="form-label fw-semibold">Correo</label>
                <input type="email" class="form-control form-control-lg" id="correo" name="correo" required/>
            </div>

            <div class="mb-3 text-start">
                <label for="contraseña" class="form-label fw-semibold">Contraseña</label>
                <input type="password" class="form-control form-control-lg" id="contraseña" name="contraseña" required/>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary w-100 btn-lg shadow-sm">Registrarte</button>
            </div>

        </form>

    </div>

</div>
