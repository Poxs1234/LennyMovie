<div class="pb-3 d-flex justify-content-center align-items-center" style="min-height: 80vh; background-color:#f8f9fa;">
    
    <div class="text-center p-4 rounded-4 shadow" style="background:white; max-width:500px; width:100%;">

        <form action="" class="mx-auto">

            <h3 class="mb-4">Iniciar Sesión</h3>

            <div class="mb-3 text-start">
                <label for="correo" class="form-label fw-semibold">Correo</label>
                <input type="email" class="form-control form-control-lg" id="correo" name="correo" required/>
            </div>

            <div class="mb-3 text-start">
                <label for="contraseña" class="form-label fw-semibold">Contraseña</label>
                <input type="password" class="form-control form-control-lg" id="contraseña" name="contraseña" required/>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary w-100 btn-lg shadow-sm">Iniciar Sesión</button>
            </div>

            <a href="/Home/CambioContra" class="d-block mt-2">¿Olvidaste tu contraseña?</a>

        </form>

    </div>

</div>

